# Copie para .env e preencha. Nunca versione o .env.
PORT=3001
LOG_LEVEL=info

# Banco próprio do Billing (Neon: database billing_db). Output do repo DB: billing_db_url
DB_URL=postgresql://postgres:postgres@localhost:5434/billing_db
DB_SSL=false

# Mensageria (saga)
RABBITMQ_URL=amqp://oficina:oficina@localhost:5672
RABBITMQ_RETRY_DELAY_MS=5000
OUTBOX_POLL_INTERVAL_MS=1000

# Mesmo JWT_SECRET do OS Service e da Lambda de login
JWT_SECRET=
# Assina os links de aprovar/recusar do e-mail (padrão: JWT_SECRET)
APPROVAL_LINK_SECRET=
# URL pública do Billing (ALB), usada nos links do e-mail e no webhook
PUBLIC_BASE_URL=http://localhost:3001

# Mercado Pago. MERCADOPAGO_MODE=fake simula o gateway (sem credenciais)
MERCADOPAGO_MODE=fake
MP_ACCESS_TOKEN=
# Uma ou mais chaves separadas por vírgula (ex.: durante a troca de chave)
MP_WEBHOOK_SECRET=
MP_SANDBOX=true
# URL enviada em cada preferência. Padrão: ${PUBLIC_BASE_URL}/webhooks/mercadopago
# "painel" = não envia; o MP usa o webhook configurado em Suas integrações (recomendado)
MP_NOTIFICATION_URL=painel
MP_BACK_URL=
# enforce (padrão) = recusa assinatura inválida | warn = só alerta (APENAS sandbox:
# avisos automáticos de contas de teste do MP não validam com a chave do painel)
MP_WEBHOOK_SIGNATURE=enforce
# Tolerância do timestamp do x-signature em segundos (0 = desligado)
MP_WEBHOOK_TOLERANCE_SECONDS=0
# Pagamento não concluído nesse prazo vira pagamento.falhou
PAYMENT_EXPIRATION_MINUTES=1440
PAYMENT_EXPIRATION_CHECK_MS=60000

# API interna do OS Service (fallback quando o evento não traz o e-mail do cliente)
OS_SERVICE_URL=http://localhost:3000
SERVICE_TOKEN=

# E-mail do orçamento (sem SMTP, o e-mail só vai para o log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

NEW_RELIC_LICENSE_KEY=
NEW_RELIC_ENABLED=false
